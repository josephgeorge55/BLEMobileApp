{
  "expo": {
    "name": "Blade Outboards",
    "slug": "blade-outboards",
    "version": "1.5.2",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "bladeoutboards",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.replit.bladeoutboards",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSLocationWhenInUseUsageDescription": "Blade Outboards uses your location to show your position relative to your outboard motor.",
        "NSBluetoothAlwaysUsageDescription": "Blade Outboards uses Bluetooth to connect to your outboard motor for real-time telemetry.",
        "NSBluetoothPeripheralUsageDescription": "Blade Outboards uses Bluetooth to communicate with your outboard motor."
      }
    },
    "android": {
      "versionCode": 5,
      "package": "com.bladeoutboards.app",
      "adaptiveIcon": {
        "backgroundColor": "#0A4D6E",
        "foregroundImage": "./assets/images/icon.png"
      },
      "edgeToEdgeEnabled": true,
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.BLUETOOTH",
        "android.permission.BLUETOOTH_ADMIN",
        "android.permission.BLUETOOTH_CONNECT",
        "android.permission.BLUETOOTH_SCAN"
      ]
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "16.0"
          },
          "android": {
            "usesCleartextTraffic": true,
            "networkSecurityConfig": "./network-security-config.xml"
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120,
          "resizeMode": "contain",
          "backgroundColor": "#000000",
          "dark": {
            "image": "./assets/images/splash-icon.png",
            "imageWidth": 120,
            "resizeMode": "contain",
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-web-browser",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow Blade Outboards to use your location to show your position relative to your motor."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#0A4D6E"
        }
      ],
      [
        "react-native-ble-plx",
        {
          "isBackgroundEnabled": true,
          "modes": ["central"],
          "bluetoothAlwaysPermission": "Blade Outboards uses Bluetooth to connect to your outboard motor for real-time telemetry data while on the water."
        }
      ],
      "./plugins/withPushNotifications",
      "./plugins/withLiveActivity",
      "./plugins/withAndroidForegroundService",
      "./plugins/withAppleWatch",
      "./plugins/withBluetoothClassic"
    ],
    "experiments": {
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "af7bf828-b9cd-4654-8fcd-06e80d8dbed0",
        "build": {
          "experimental": {
            "ios": {
              "appExtensions": [
                {
                  "targetName": "BladeOutboardsWidgetExtension",
                  "bundleIdentifier": "app.replit.bladeoutboards.widget",
                  "entitlements": {}
                },
                {
                  "targetName": "BladeOutboardsWatch",
                  "bundleIdentifier": "app.replit.bladeoutboards.watchkitapp",
                  "entitlements": {}
                }
              ]
            }
          }
        }
      }
    }
  }
}